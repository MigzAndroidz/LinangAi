# Linang AI — Environment Variables Reference
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local — it is already in .gitignore.

# ─── CLIENT-SIDE (prefix with VITE_ — bundled into the browser build) ────────

# Your VAPID public key (base64url encoded).
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
# The PUBLIC key goes here; the PRIVATE key is server-only (see below).
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ─── SERVER-ONLY (set in Vercel Project Settings → Environment Variables) ─────
# These are NEVER prefixed with VITE_ and must NOT be in this file for production.
# They are listed here for documentation purposes only.
#
# VAPID_PUBLIC_KEY=        ← same value as VITE_VAPID_PUBLIC_KEY (no VITE_ prefix)
# VAPID_PRIVATE_KEY=       ← the private half of your VAPID key pair (keep secret!)
# VAPID_SUBJECT=           ← mailto: or https: URI identifying your app
#                             e.g.  mailto:admin@linang.ai
#
# UPSTASH_REDIS_REST_URL=  ← from Upstash Console → REST API → Endpoint
# UPSTASH_REDIS_REST_TOKEN=← from Upstash Console → REST API → Token (read/write)
#
# CRON_SHARED_SECRET=      ← any long random string; set the SAME value in
#                             GitHub → Repository Settings → Secrets → Actions
#                             as CRON_SHARED_SECRET

# ─── OPTIONAL DEV-ONLY ───────────────────────────────────────────────────────

# Set to 'true' to seed Alex Rivera / Elena Rostova demo data in local dev.
# Must be false (or unset) in production.
# VITE_SEED_DEMO_DATA=true
